# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Base de datos (local) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pymeflowec
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SSL=false

# ── Base de datos (AWS RDS producción) ───────────────────────
# DB_HOST=tu-instancia.rds.amazonaws.com
# DB_SSL=true

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secret_seguro_minimo_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=otro_secret_diferente_para_refresh_token
JWT_REFRESH_EXPIRES_IN=7d

# ── Nodemailer (reset password) ──────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password_de_gmail
MAIL_FROM=PymeFlowEc <no-reply@pymeflowec.com>

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Frontend URL (para CORS) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Redis (rate limiting distribuido) ───────────────────────
# Local: dejar vacío → los limiters usan memoria en proceso
# AWS ElastiCache: redis://tu-cluster.cache.amazonaws.com:6379
# REDIS_URL=

# ── Logging ──────────────────────────────────────────────────
# LOG_TO_FILE=false  → desactiva archivos (recomendado en ECS/Lambda,
#                      CloudWatch captura stdout directamente)
# LOG_TO_FILE=true   → escribe logs/ en disco (default)
# LOG_TO_FILE=